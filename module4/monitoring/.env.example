# Copy this file to .env and fill in values from `terraform output`.
# Do NOT commit .env — it is excluded by .gitignore.

# From: terraform output -raw producer_connection_string
SERVICE_BUS_PRODUCER_CONNECTION_STRING="Endpoint=sb://<CHANGE_ME>.servicebus.windows.net/;SharedAccessKeyName=producer-send;SharedAccessKey=<CHANGE_ME>;EntityPath=orders"

# From: terraform output -raw consumer_connection_string
SERVICE_BUS_CONSUMER_CONNECTION_STRING="Endpoint=sb://<CHANGE_ME>.servicebus.windows.net/;SharedAccessKeyName=consumer-listen;SharedAccessKey=<CHANGE_ME>;EntityPath=orders"

SERVICE_BUS_QUEUE_NAME=orders
