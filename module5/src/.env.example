# Copy to .env and fill in values from `terraform output`.
# .env is gitignored — never commit it.

# PostgreSQL — get FQDNs from Terraform output
PG_PRIMARY_HOST=<value from: terraform output -raw postgres_primary_fqdn>
PG_REPLICA_HOST=<value from: terraform output -raw postgres_replica_fqdn>
PG_USER=pgadmin
PG_PASSWORD=PostgreSQL@Module5
PG_DB=catalog
PG_SSLMODE=require
PG_PORT=5432

# Redis — get hostname from Terraform output; port 6380 is the TLS port
REDIS_HOST=<value from: terraform output -raw redis_hostname>
REDIS_PORT=6380
REDIS_PASSWORD=<primary access key — az keyvault secret show --vault-name (terraform output -raw key_vault_name) --name redis-primary-key --query value -o tsv>
REDIS_TLS=true

# Azure Blob Storage — get storage account name from Terraform output
AZURE_STORAGE_ACCOUNT=<value from: terraform output -raw storage_account_name>
AZURE_STORAGE_KEY=<primary access key — az keyvault secret show --vault-name (terraform output -raw key_vault_name) --name storage-account-key --query value -o tsv>
